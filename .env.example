APP_NAME=tkcrm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8780
# Dev ports (docker-compose.yml). Wicket uses 8777 and 5777, Nugget 8778, 5778 and 8779.
#   APP_PORT      the app, Octane on FrankenPHP
#   VITE_PORT     the Vite dev server (hot reload); VITE_HOST is the name the browser reaches it on
#   MAILPIT_PORT  the Mailpit web UI, where all dev mail lands
APP_PORT=8780
VITE_HOST=localhost
VITE_PORT=5780
MAILPIT_PORT=8781

# Behind a reverse proxy that ends TLS: the proxy's address, a comma list, or * for any.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=data/tkcrm.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Dev: sent to the mailpit container (SMTP on 1025 inside the compose network), read at
# http://localhost:${MAILPIT_PORT}. Use MAIL_MAILER=log to write messages to storage/logs/laravel.log instead;
# with no MAIL_MAILER at all that is what happens. Live: the mail provider's SMTP host, port, username and password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set to one address to send every message there instead of to whoever it was for, with the
# subject saying who that was. For trial runs against real client data. Empty: mail goes where it is addressed.
MAIL_REDIRECT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The tktask database `php artisan tkcrm:import-tktask` reads: a copy of the live one loaded into
# tktask's own dev stack. Never point this at the live server.
#   From the app container, the host machine is host.docker.internal.
TKTASK_DB_HOST=host.docker.internal
TKTASK_DB_PORT=3306
TKTASK_DB_DATABASE=tktask
TKTASK_DB_USERNAME=
TKTASK_DB_PASSWORD=
