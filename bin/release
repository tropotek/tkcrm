#!/usr/bin/env bash
# Tag a release after the code style check and the test suite pass locally. Pushing the tag
# starts the GHCR build (.github/workflows/release.yml), which publishes ghcr.io/tropotek/tkcrm
# as the version and as latest.
#
#   bin/release v1.2.3
set -euo pipefail

version="${1:-}"
if [[ ! "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
    echo "Usage: bin/release vMAJOR.MINOR.PATCH[-pre]" >&2
    exit 1
fi

cd "$(dirname "$0")/.."

if [[ "$(git rev-parse --abbrev-ref HEAD)" != "main" ]]; then
    echo "Release from main." >&2
    exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
    echo "Commit or stash your changes first." >&2
    exit 1
fi
if git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
    echo "Tag $version already exists." >&2
    exit 1
fi
if ! git remote get-url origin >/dev/null 2>&1; then
    echo "There is no origin to push to. Add the GitHub repository first: git remote add origin git@github.com:tropotek/tkcrm.git" >&2
    exit 1
fi
git fetch --quiet origin main
if [[ -n "$(git log origin/main..HEAD --oneline 2>/dev/null)" ]]; then
    echo "main has commits that are not on origin. Push them first: the image is built from what GitHub has." >&2
    exit 1
fi

echo "==> Code style"
# Without </dev/null, docker reads the terminal's input and takes the answer to the question below.
docker compose exec -T app vendor/bin/pint --test </dev/null

echo "==> Tests"
docker compose exec -T app composer test </dev/null

git tag -a "$version" -m "Release $version"
echo "Tagged $version."

read -r -p "Push $version to origin now (starts the image build)? [y/N] " answer
if [[ "$answer" =~ ^[Yy]$ ]]; then
    git push origin "$version"
else
    echo "Push later with: git push origin $version"
fi
